timestamp=2026-11-14T20:58:36.281Z level=INFO run=6ee92965 message=evaluated permission=bash pattern="python3 - << 'EOF'\n# Current demand trajectory starting m3=7.81 (or true trend ~6*1.08^3 = 7.56):\n# Wait: 5.67, 6.16, 7.38, 7.81 -> estimate base d0:\n# d0 * [1, 1.08, 1.1664, 1.2597] -> avg(actual / 1.08^t)\nvals = [5.67, 6.16, 7.38, 7.81]\nd0_est = sum(v / (1.08**t) for t, v in enumerate(vals)) / 4\nprint(f\"Estimated true d0 (at 8%): {d0_est:.3f}\")\nfor sw in [99, 8, 12, 15]:\n    d = d0_est\n    dem = []\n    for m in range(24):\n        dem.append(d)\n        r = 0.08 if m < sw else 0.04\n        d *= (1 + r)\n    print(f\"sw={sw:2d}: W2_inf={sum(dem[8:16]):.1f}, W2_tot(+140)={sum(dem[8:16])+140:.1f} | \"\n          f\"W3_inf={sum(dem[16:24]):.1f}, W3_tot(+320)={sum(dem[16:24])+320:.1f} | \"\n          f\"eu_m10={0.3*dem[10]:.2f}, eu_m15={0.3*dem[15]:.2f}, eu_m23={0.3*dem[23]:.2f}, us_m23={0.5*dem[23]:.2f}\")\nEOF" action.permission=* action.action=allow action.pattern=*
