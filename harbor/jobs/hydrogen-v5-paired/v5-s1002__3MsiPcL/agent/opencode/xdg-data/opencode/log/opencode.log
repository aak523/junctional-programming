timestamp=2026-11-14T21:00:14.537Z level=INFO run=6ee92965 message=evaluated permission=bash pattern="python3 - << 'EOF'\nimport math\nobs = [5.67, 6.16, 7.38, 7.81, 8.40, 9.04, 9.36, 11.42, 12.15, 12.13]\n# Likelihood under no switch (8% always) vs switch to 4% at month s in 8..9 (using sigma=0.05 lognormal around d0*trend)\ndef loglik(sw, d0=6.0):\n    d = d0\n    ll = 0.0\n    for m, y in enumerate(obs):\n        err = (math.log(y) - math.log(d)) / 0.05\n        ll += -0.5 * err * err\n        r = 0.08 if m < sw else 0.04\n        d *= (1 + r)\n    return ll\n\nfor d0 in [5.9, 6.0, 6.1]:\n    lls = {sw: loglik(sw, d0) for sw in [99, 8, 9]}\n    mx = max(lls.values())\n    ps = {k: math.exp(v - mx) for k, v in lls.items()}\n    s = sum(ps.values())\n    print(f\"d0={d0}: \" + \", \".join(f\"sw={k}:{v/s:.2f}\" for k, v in ps.items()))\n\n# Also check Window 2 capacity & training with current fleet:\n# m8..9 done: 43.70.\n# m10..12 (3 mos): 32k H + 2 ap + 1 eu = 35 kH/mo = 105 kH-mo\n# m13..15 (3 mos): 32k H + 1 ap + 1 eu = 34 kH/mo = 102 kH-mo\n# Total m10..15 capacity = 207 kH-mo!\nfor sw in [99, 8, 12]:\n    d = 6.0\n    inf_10_15 = 0\n    for m in range(16):\n        if m >= 10: inf_10_15 += d\n        d *= (1.08 if m < sw else 1.04)\n    print(f\"sw={sw:2d}: m10..15 inf={inf_10_15:.1f}, train_m10..15={207-inf_10_15:.1f}, total_W2={43.7+207-inf_10_15:.1f}/140\")\nEOF" action.permission=* action.action=allow action.pattern=*
