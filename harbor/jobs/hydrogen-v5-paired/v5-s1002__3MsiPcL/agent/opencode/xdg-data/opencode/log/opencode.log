timestamp=2026-11-14T21:00:56.028Z level=INFO run=6ee92965 message=evaluated permission=bash pattern="python3 - << 'EOF'\n# Check Window 3 (m16..23) exact needs under:\n# Case A: 8% always (50% of worlds if still 8% at m11 -> actually if 50% never switch, and 50% switch in m8..15, given no switch by m11, P(never switch) ~ 65%!)\n# Case B: switch to 4% at m12..15 (~35% chance)\nfor label, sw in [(\"8% always\", 99), (\"switch m12\", 12), (\"switch m14\", 14)]:\n    d = 6.0\n    dem = []\n    for m in range(24):\n        dem.append(d)\n        d *= (1.08 if m < sw else 1.04)\n    w3_inf = sum(dem[16:24])\n    w3_tot = w3_inf + 320\n    # Existing powered capacity in m16..23:\n    # m16..19 (4 mos): us 10k H + eu 4k H + ap 18k H + ap 1k res = 33 kH/mo = 132 kH-mo\n    # m20..23 (4 mos): us 10 MW expires (us keeps 6 MW + 10 MW new = 16 MW -> all 10k H stays powered!! + 2 MW spare = 1.25k N!)\n    #                  eu 6 MW expires (eu drops from 4k H to 0k H!)\n    #                  ap 18k H + 1k res = 19 kH/mo\n    # Wait! In m20..23: us 10k H + ap 18k H + ap 1k res = 29 kH/mo = 116 kH-mo!\n    # Total existing W3 = 132 + 116 = 248 kH-mo!\n    deficit = w3_tot - 248\n    print(f\"{label:12s}: W3_inf={w3_inf:.1f}, W3_tot={w3_tot:.1f}, existing=248 -> DEFICIT={deficit:.1f} kH-mo ({deficit/8:.1f} kH/mo avg!)\")\n    print(f\"   m16..23 site inf: us={0.5*dem[16]:.1f}->{0.5*dem[23]:.1f}, eu={0.3*dem[16]:.1f}->{0.3*dem[23]:.1f}, ap={0.2*dem[16]:.1f}->{0.2*dem[23]:.1f}\")\nEOF" action.permission=* action.action=allow action.pattern=*
