timestamp=2026-11-14T21:02:38.726Z level=INFO run=6ee92965 message=evaluated permission=bash pattern="python3 - << 'EOF'\n# Remaining W3 training needed (m17..23): 288.26 kH-mo\n# Estimated inference demand in m17..23 (from m16=19.72, 8%/mo):\n# Wait: m16=19.72, 6.0*1.08^16 = 20.55 -> true trend at m17 ~ 21.8 or 21.3 (let's use upper-conservative 21.6 at m17!):\nd17 = 21.6\ninf = {m: d17 * (1.08 ** (m - 17)) for m in range(17, 24)}\ntot_inf_17_23 = sum(inf.values())\nprint(f\"m17..23 expected inf={tot_inf_17_23:.1f} (with +5% safety: {tot_inf_17_23*1.02:.1f})\")\nprint(f\"Total capacity needed m17..23 = {tot_inf_17_23:.1f} + 288.26 = {tot_inf_17_23 + 288.26:.1f} kH-mo!\")\n\n# Existing + Wave 1 capacity in m17..23:\n# m17: us=14, eu=9, ap=18+3.14*2+8 = 32.28 => 55.28!\n# m18..19: us=14, eu=9, ap=32.28 => 55.28/mo (plus new N shipments!)\n# m20..21: us=14, eu=4 (eu 6MW expired! 1k res expired!), ap=32.28 => 50.28/mo\n# m22..23: us=10 (Wave 1 expired!), eu=0 (Wave 1 expired!), ap=25.28 (Wave 1 expired!) => 35.28/mo\nbase_17_23 = 55.28*3 + 50.28*2 + 35.28*2 # 165.84 + 100.56 + 70.56 = 336.96 kH-mo!\n# Plus remaining Vendor N queue (3.86k N = 7.72 kH: #6 0.86k ap, #7 1.0k us, #8 2.0k ap):\n# If tight (1.5k/mo = 3 kH/mo):\n#   m17: ships 1.5k (0.86 ap + 0.64 us -> available m18!) => m18:+3, m19:+6, m20:+7.72, m21:+7.72, m22:+7.72, m23:+7.72 => +39.88 kH-mo!\n#   (Even if tight ships only 1.1k/mo -> +33 kH-mo!)\n# Total base + Wave1 + N = 336.96 + ~39.88 = 376.84 kH-mo!\n# Deficit for m17..23 = (tot_inf_17_23 + 288.26) - 376.84:\nfor m in range(17, 24):\n    print(f\"  m{m}: inf={inf[m]:.2f} (us={0.5*inf[m]:.2f}, eu={0.3*inf[m]:.2f}, ap={0.2*inf[m]:.2f})\")\ndeficit = tot_inf_17_23 + 288.26 - 376.84\nprint(f\"Deficit = {deficit:.1f} kH-mo -> divided by 6 mos (m18..23) = {deficit/6:.1f} kH of Wave 2 options!\")\n# Check site inference in m22..23 (after Wave 1 expires):\n#   us has 10 + 2 (N #7) = 12 kH. m22..23 us inf = 15.9..17.2 (+5% noise up to 18.0!) -> need +6..7 kH in us!\n#   eu has 0 kH! m22..23 eu inf = 9.5..10.3 (+5% noise up to 10.8!) -> need +11 kH in eu!\n#   ap has 18 + 6.86*2 + 1 = 32.72 kH (m22..23 ap inf = 6.4..6.9 -> huge spare!)\n# Notice: 7 us + 11 eu = 18 kH -> 18 * 6 = 108 kH-mo!\nprint(f\"With 18 kH Wave 2 (7 us + 11 eu): total = {376.84 + 108:.1f} vs needed {tot_inf_17_23 + 288.26:.1f}!\")\nEOF" action.permission=* action.action=allow action.pattern=*
