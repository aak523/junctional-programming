timestamp=2026-11-14T20:56:56.967Z level=INFO run=6ee92965 message=evaluated permission=bash pattern="python3 - << 'EOF'\n# Compare 1 kH capacity over months 3..23 (21 months) or 3..15 (13 months)\n# 1. Buy 1k Gen H at month 0 ($25M upfront) + power ($0.12*1.4=$0.168/mo in ap, or $0.21/mo in us)\n# Suppose power signed at m0 energises at m5, runs m5..28 (24 mos -> 19 useful mos, 5 post-23 mos)\n# Wait: if bought at m0, earliest usable is m3 (if vendor loose and queue empty; wait queue has 4k already!\n# Queue has 4k placed m-2, eligible m1. If m1 is loose, vendor ships 4k in m1 (and 2k more if ordered? Wait:\n# \"Orders join one FIFO queue... usable from 3 months after ordering at the earliest.\"\n# So an order placed at m0 is NOT eligible until m3! At m1..m2 the 4k clears, so m0 order ships at m3 if loose!))\n\nfor site, p_price, mult in [(\"us\", 0.15, 1.00), (\"ap\", 0.12, 0.95), (\"eu\", 0.20, 1.10)]:\n    for launch_m in [10, 12, 14]:\n        # Gen H bought m0: capex 25, salvage at m24 = 0.75 * 25 * 0.96^24 * 0.5\n        salvage = 0.75 * 25 * (0.96**24) * 0.5\n        # interest opportunity cost: 0.75%/mo on 25M for ~20 mos ~ 3.75 (roughly)\n        power_24 = 24 * (1.4 * p_price)\n        # usable m3..23 = 21 mos (or if power energises m5, m5..23 = 19 mos)\n        net_cost_21 = 25 - salvage + power_24 + 3.5\n        print(f\"Gen H {site} (launch m{launch_m}): capex-salv={25-salvage:.2f}, pwr24={power_24:.2f}, int~3.5 => {net_cost_21:.2f} / 19..21mo = {net_cost_21/20:.2f}/kH-mo\")\n\nprint(\"---\")\n# Compare 12m reserve at m0 (index 1.60), m1..m12:\n# What if reserve 24m at m0 in ap? 24 * 1.44 * 0.95 = 32.83 for 23 useful mos = 1.43/kH-mo (no power needed, starts m1!)\nfor site, mult in [(\"us\", 1.0), (\"ap\", 0.95), (\"eu\", 1.1)]:\n    c6 = 1.84 * mult\n    c12 = 1.60 * mult\n    c24_eff = 1.44 * mult * 24 / 23\n    print(f\"Reserve {site}: 6m={c6:.3f}/mo, 12m={c12:.3f}/mo, 24m_eff={c24_eff:.3f}/mo\")\nEOF" action.permission=* action.action=allow action.pattern=*
