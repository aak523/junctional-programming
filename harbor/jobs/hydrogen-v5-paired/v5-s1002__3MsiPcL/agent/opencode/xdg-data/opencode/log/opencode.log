timestamp=2026-11-14T20:56:35.757Z level=INFO run=6ee92965 message=evaluated permission=bash pattern="python3 - << 'EOF'\nfor label, r1, r2, sw in [\n    (\"4% always\", 0.04, 0.04, 99),\n    (\"8% always\", 0.08, 0.08, 99),\n    (\"4%->8% at m8\", 0.04, 0.08, 8),\n    (\"4%->8% at m12\", 0.04, 0.08, 12),\n    (\"8%->4% at m8\", 0.08, 0.04, 8),\n]:\n    d = 6.0\n    demands = []\n    for m in range(24):\n        demands.append(d)\n        r = r1 if m < sw else r2\n        d *= (1 + r)\n    w1_inf = sum(demands[0:8])\n    w2_inf = sum(demands[8:16])\n    w3_inf = sum(demands[16:24])\n    print(f\"{label:15s}: m0={demands[0]:.1f} m7={demands[7]:.1f} m15={demands[15]:.1f} m23={demands[23]:.1f} | \"\n          f\"Total kH-mo needed (inf+train): \"\n          f\"w1={w1_inf:.0f}+60={w1_inf+60:.0f} ({(w1_inf+60)/8:.1f}/mo), \"\n          f\"w2={w2_inf:.0f}+140={w2_inf+140:.0f} ({(w2_inf+140)/8:.1f}/mo), \"\n          f\"w3={w3_inf:.0f}+320={w3_inf+320:.0f} ({(w3_inf+320)/8:.1f}/mo)\")\nEOF" action.permission=* action.action=allow action.pattern=*
