timestamp=2026-11-14T21:16:55.307Z level=INFO run=7c5722be message=evaluated permission=bash pattern="python3 -c '\n# Simulate cash from m13 to m23 with:\n# - Start m13 cash: 484.5M\n# - Order 5k Gen N at m13: -$200M\n# - Monthly funding: +$40M/mo\n# - Power: ~$7.4M/mo (rising to $9.9M/mo at m14, dropping -$2.7M/mo at m20)\n# - Existing reservations: ~$23M/mo in m13, tapering down to $0 by m19\n# - New options in m15 (say 18 options, m16..21) and m17 (say 18 options, m18..23):\n#   $18M at m15, $18M at m17, + $28.8M/mo in m16..17, $57.6M/mo in m18..21, $28.8M/mo in m22..23\ncash = 484.5 - 200.0\nfor m in range(13, 24):\n    # approx monthly outflows\n    pwr = 7.4 if m < 14 else (9.9 if m < 20 else 7.2)\n    old_res = 22.0 if m==13 else (19.0 if m==14 else (15.0 if m==15 else (6.5 if m==16 else (3.2 if m<=18 else 0))))\n    opt_up = 18.0 if m in [15, 17] else 0.0\n    opt_mo = 0.0\n    if 16 <= m <= 21: opt_mo += 18 * 1.6\n    if 18 <= m <= 23: opt_mo += 18 * 1.6\n    interest = cash * (0.0075 if cash >= 0 else 0.02)\n    cash = cash + 40.0 - pwr - old_res - opt_up - opt_mo + interest\n    print(f\"End m{m}: cash=${cash:.1f}M (pwr={pwr:.1f}, old_res={old_res:.1f}, opt={opt_up+opt_mo:.1f})\")\n'" action.permission=* action.action=allow action.pattern=*
