timestamp=2026-11-14T21:12:54.425Z level=INFO run=7c5722be message=evaluated permission=bash pattern="python3 -c '\ndef fc(amt, m, r=0.0075):\n    return amt * ((1+r)**(24-m))\n\n# Gen H bought at m=1 ($25M), usable m=6..23 (18 mos) in ap ($0.168/mo power, say power signed m=1 energised m=4 -> 4 extra mos m24..27)\nc_H_m1 = fc(25, 1) - 3.5195 + sum(fc(0.168, m) for m in range(4, 28))\nprint(f\"Gen H bought m=1 (usable m6..23, 18 mos, ap): total m24=${c_H_m1:.2f}M -> ${c_H_m1/18:.3f}M/kH-mo\")\n\n# What if Gen H bought at m=1 is only usable m=7..23 (17 mos)?\nc_H_m1_17 = fc(25, 1) - 3.5195 + sum(fc(0.168, m) for m in range(5, 29))\nprint(f\"Gen H bought m=1 (usable m7..23, 17 mos, ap): total m24=${c_H_m1_17:.2f}M -> ${c_H_m1_17/17:.3f}M/kH-mo\")\n\n# Compare with Cloud 12m in ap at m=1 ($1.532/mo, m2..13) + Cloud 12m at m=13 (say index after 25% drop is 1.35 -> 1.28/mo):\n# Cloud ap m2..13 cost per mo = $1.532M (plus ~7% interest avg -> ~$1.64M at m24)\n# Wait: compare at m=24 future cost!\nc_cloud_m1 = sum(fc(1.532, m) for m in range(2, 14))\nprint(f\"Cloud 12m ap at m=1 (12 mos, m2..13): total m24=${c_cloud_m1:.2f}M -> ${c_cloud_m1/12:.3f}M/kH-mo\")\nc_cloud_us_m1 = sum(fc(1.613, m) for m in range(2, 14))\nprint(f\"Cloud 12m us at m=1 (12 mos, m2..13): total m24=${c_cloud_us_m1:.2f}M -> ${c_cloud_us_m1/12:.3f}M/kH-mo\")\n'" action.permission=* action.action=allow action.pattern=*
