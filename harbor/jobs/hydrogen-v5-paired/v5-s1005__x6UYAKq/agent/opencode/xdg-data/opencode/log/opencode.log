timestamp=2026-11-14T21:16:38.261Z level=INFO run=7c5722be message=evaluated permission=bash pattern="python3 -c '\ndef fc(amt, m, r=0.0075):\n    return amt * ((1+r)**(24-m))\n\n# Compare ordering Gen N at month m_order (arriving at m_arr, usable m_arr..23)\n# Suppose we pay $20M/kH at m_order.\n# Marked at m24 = 0.75 * 20 * 0.96^(24-13) = $9.575M/kH! (Notice: used value is 40 * 0.96^(months since launch), launch=13, so at m24 it is ALWAYS 0.96^11 = 9.575M/kH regardless of when ordered!!)\n# Wait: check rule: \"gen N $40M x 0.96^(months since launch)\"!\n# Yes! At m24 (11 months since launch at m13), 75% mark = 0.75 * 20 * 0.96^11 = $9.575M/kH!\nmark_m24 = 0.75 * 20 * (0.96**11)\nprint(f\"Gen N m24 mark per kH = ${mark_m24:.3f}M (regardless of order month!)\")\n\nfor m_ord in [13, 14, 15, 16, 17, 18]:\n    m_arr = m_ord + 3\n    usable = 24 - m_arr\n    if usable <= 0: continue\n    # Power in ap ($0.096/mo for 24 mos, say starting at m_arr -> 24 mos):\n    # Wait: if we already contracted ap power (e.g. 18.2 MW spare at m14) + us power (16 MW spare at m14),\n    # that power is ALREADY SUNK if not used! Wait: we should check BOTH with new power AND with sunk power!\n    c_no_pwr = fc(20, m_ord) - mark_m24\n    c_with_ap_pwr = c_no_pwr + sum(fc(0.096, m) for m in range(m_arr, m_arr+24))\n    print(f\"Order m{m_ord} -> arrive m{m_arr} ({usable} usable mos): no_new_pwr=${c_no_pwr/usable:.3f}M/mo | with_new_ap_pwr=${c_with_ap_pwr/usable:.3f}M/mo\")\n\n# Compare with Capacity Options exercised for 6 mos at m15 (m16..21) or m17 (m18..23):\n# $1M upfront + $1.6M/mo * 6 mos (all within m16..23 -> ZERO wasted tail!):\nc_opt_15 = fc(1.0, 15) + sum(fc(1.6, m) for m in range(16, 22))\nc_opt_17 = fc(1.0, 17) + sum(fc(1.6, m) for m in range(18, 24))\nprint(f\"Option exercised m15 (m16..21, 6 mos): ${c_opt_15/6:.3f}M/mo (m24 value)\")\nprint(f\"Option exercised m17 (m18..23, 6 mos): ${c_opt_17/6:.3f}M/mo (m24 value)\")\n'" action.permission=* action.action=allow action.pattern=*
