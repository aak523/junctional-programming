timestamp=2026-11-14T21:10:54.089Z level=INFO run=7c5722be message=evaluated permission=bash pattern="python3 -c '\nfor g_label, g_fn in [\n    (\"4% constant\", lambda m: 0.04),\n    (\"8% constant\", lambda m: 0.08),\n    (\"4% -> 8% at m=10\", lambda m: 0.04 if m < 10 else 0.08),\n    (\"8% -> 4% at m=10\", lambda m: 0.08 if m < 10 else 0.04),\n]:\n    d = 6.0\n    demands = []\n    for m in range(24):\n        demands.append(d)\n        d *= (1 + g_fn(m))\n    print(f\"{g_label:18s}: m0={demands[0]:.1f}, m7={demands[7]:.1f}, m15={demands[15]:.1f}, m23={demands[23]:.1f}, sum={sum(demands):.1f}\")\n    print(f\"   Run1 (0..7) inf={sum(demands[0:8]):.1f}+60={sum(demands[0:8])+60:.1f} (avg {(sum(demands[0:8])+60)/8:.1f}/mo)\")\n    print(f\"   Run2 (8..15) inf={sum(demands[8:16]):.1f}+140={sum(demands[8:16])+140:.1f} (avg {(sum(demands[8:16])+140)/8:.1f}/mo)\")\n    print(f\"   Run3 (16..23) inf={sum(demands[16:24]):.1f}+320={sum(demands[16:24])+320:.1f} (avg {(sum(demands[16:24])+320)/8:.1f}/mo)\")\n'" action.permission=* action.action=allow action.pattern=*
