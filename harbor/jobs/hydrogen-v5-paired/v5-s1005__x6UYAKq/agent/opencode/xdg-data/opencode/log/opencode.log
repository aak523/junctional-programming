timestamp=2026-11-14T21:18:56.934Z level=INFO run=7c5722be message=evaluated permission=bash pattern="python3 << 'EOF'\nobs = [6.64, 6.27, 7.13, 7.55, 8.43, 8.32, 9.31, 11.73, 10.83, 12.67, 12.63, 14.76, 15.60, 17.35, 19.93, 18.18, 20.84, 24.24]\ndef best_ll(gs):\n    prod = [1.0]\n    for g in gs: prod.append(prod[-1]*(1+g))\n    d0 = sum(o/p for o, p in zip(obs, prod)) / len(obs)\n    ll = sum(-0.5 * ((o - d0*p)/(0.05*d0*p))**2 for o, p in zip(obs, prod))\n    return ll, d0\n\nll_8, d0_8 = best_ll([0.08]*17)\nprint(f\"8% constant: d0={d0_8:.3f}, ll={ll_8:.2f}\")\nfor m_sw in [13, 14, 15]:\n    gs = [0.08 if m < m_sw else 0.04 for m in range(17)]\n    ll, d0 = best_ll(gs)\n    print(f\"Switch 4% at m={m_sw}: d0={d0:.3f}, ll={ll:.2f}\")\n\n# Run 3 training done in m16..17 = 63.95 / 320 -> remaining for m18..23 = 256.05 kH-mo!\n# Committed capacity in m18..23 (with 4k H moved eu->ap in m19):\n# m18: us=26.14, eu=20.00, ap=31.86 -> total = 78.00\n# m19: us=25.14, eu=16.00 (moved 4k H out!), ap=31.86 -> total = 73.00\n# m20: us=25.14, eu=16.00, ap=35.86 -> total = 77.00\n# m21: us=25.14, eu=16.00, ap=35.86 -> total = 77.00\n# m22: us=19.14, eu=12.00, ap=25.86 -> total = 57.00\n# m23: us=19.14, eu=12.00, ap=25.86 -> total = 57.00\ncaps = [78.0, 73.0, 77.0, 77.0, 57.0, 57.0]\nprint(f\"\\nCommitted cap m18..23 = {sum(caps):.1f} kH-mo (with m19 move of 4k H eu->ap)\")\nfor g_label, g in [(\"8% constant\", 0.08), (\"switch 4% at m15\", 0.04)]:\n    d = d0_8 * (1.08**17)\n    infs = []\n    for m in range(18, 24):\n        d *= (1+g)\n        infs.append(d)\n    tot_needed = sum(infs) + 256.05\n    gap = tot_needed - sum(caps)\n    print(f\"{g_label}: m18..23 inf={sum(infs):.1f} + 256.05 = {tot_needed:.1f} vs {sum(caps):.1f} -> gap = {gap:.1f} kH-mo!\")\n    for idx, m in enumerate(range(18, 24)):\n        t = infs[idx]\n        print(f\"  m{m}: inf={t:.1f} (us={0.5*t:.1f}, eu={0.3*t:.1f}, ap={0.2*t:.1f}) | cap={caps[idx]:.1f} | train={caps[idx]-t:.1f}\")\nEOF" action.permission=* action.action=allow action.pattern=*
