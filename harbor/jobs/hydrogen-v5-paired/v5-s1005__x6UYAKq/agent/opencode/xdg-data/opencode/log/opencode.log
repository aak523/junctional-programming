timestamp=2026-11-14T21:18:35.592Z level=INFO run=7c5722be message=evaluated permission=bash pattern="python3 << 'EOF'\nimport math\nobs = [6.64, 6.27, 7.13, 7.55, 8.43, 8.32, 9.31, 11.73, 10.83, 12.67, 12.63, 14.76, 15.60, 17.35, 19.93, 18.18, 20.84]\ndef best_ll(gs):\n    prod = [1.0]\n    for g in gs: prod.append(prod[-1]*(1+g))\n    d0 = sum(o/p for o, p in zip(obs, prod)) / len(obs)\n    ll = sum(-0.5 * ((o - d0*p)/(0.05*d0*p))**2 for o, p in zip(obs, prod))\n    return ll, d0\n\nll_8, d0_8 = best_ll([0.08]*16)\nprint(f\"8% constant: d0={d0_8:.3f}, ll={ll_8:.2f}, pred_m16={d0_8*1.08**16:.2f}\")\nfor m_sw in range(8, 16):\n    gs = [0.08 if m < m_sw else 0.04 for m in range(16)]\n    ll, d0 = best_ll(gs)\n    print(f\"Switch to 4% at m={m_sw}: d0={d0:.3f}, ll={ll:.2f}, pred_m16={d0*math.prod(1+g for g in gs):.2f}\")\n\ncomm_m17_23 = 54 + 54 + (53 - 4) + 53 + 53 + 33 + 33 # if move 4k in m19\nprint(f\"\\nCommitted cap m17..23 (moving 4k H eu->ap in m19) = {comm_m17_23} kH-mo\")\nfor label, gs in [(\"8% constant\", [0.08]*8), (\"switch 4% at m15\", [0.04]*8)]:\n    d = d0_8 * (1.08**16)\n    infs = []\n    for m in range(17, 24):\n        d *= (1 + gs[m-17])\n        infs.append(d)\n    tot_needed = sum(infs) + 285.81\n    gap = tot_needed - comm_m17_23\n    print(f\"{label}: m17..23 inf={sum(infs):.1f} + 285.81 = {tot_needed:.1f} -> gap={gap:.1f} kH-mo ({gap/6:.1f} six-mo options)\")\n    for idx, m in enumerate(range(17, 24)):\n        t = infs[idx]\n        print(f\"  m{m}: tot={t:.1f} | us={0.5*t:.1f}, eu={0.3*t:.1f}, ap={0.2*t:.1f}\")\nEOF" action.permission=* action.action=allow action.pattern=*
