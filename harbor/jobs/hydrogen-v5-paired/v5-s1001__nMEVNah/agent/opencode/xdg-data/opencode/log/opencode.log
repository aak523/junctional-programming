timestamp=2026-11-14T21:01:15.319Z level=INFO run=0d3e2444 message=evaluated permission=bash pattern="python3 -c '\n# Locked capacity in m16..23 (once remaining 0.1k N ships in m15->m16):\n# m16..19: us=7.14, eu=4.00, ap=6.86+23.00+3(res)=32.86 -> total=44.00/mo * 4 = 176.00\n# m20..21: us=0, eu=0, ap=29.86+3(res)=32.86 -> total=32.86/mo * 2 = 65.72\n# m22..23: us=0, eu=0, ap=29.86 -> total=29.86/mo * 2 = 59.72\n# Total locked = 301.44 kH-months!\nlocked = [44.0, 44.0, 44.0, 44.0, 32.86, 32.86, 29.86, 29.86]\n# Inference projections for m16..23:\n# Case A: stayed 4% (m14=11.68 was +12% spike around 10.39): m16=11.24 .. m23=14.79\ninf4 = [10.39 * (1.04**(t-14)) for t in range(16, 24)]\n# Case B: switched to 8% (from m14=11.68 or m13=9.61*1.08^t): m15=12.61, m16=13.62 .. m23=23.34\ninf8 = [11.68 * (1.08**(t-14)) for t in range(16, 24)]\n\nprint(\"Locked sum m16..23:\", sum(locked))\nprint(\"Case 4%: inf_sum=\", round(sum(inf4),1), \"need=\", round(320+sum(inf4),1), \"shortfall=\", round(320+sum(inf4)-sum(locked),1))\nprint(\"Case 8%: inf_sum=\", round(sum(inf8),1), \"need=\", round(320+sum(inf8),1), \"shortfall=\", round(320+sum(inf8)-sum(locked),1))\nprint(\"Case 8% us demand m16..23:\", [round(0.5*x,2) for x in inf8])\nprint(\"Case 8% eu demand m16..23:\", [round(0.3*x,2) for x in inf8])\nprint(\"Case 4% us demand m16..23:\", [round(0.5*x,2) for x in inf4])\nprint(\"Case 4% eu demand m16..23:\", [round(0.3*x,2) for x in inf4])\n'" action.permission=* action.action=allow action.pattern=*
