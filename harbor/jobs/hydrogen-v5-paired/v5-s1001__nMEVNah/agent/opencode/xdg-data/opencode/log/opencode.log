timestamp=2026-11-14T21:02:02.745Z level=INFO run=0d3e2444 message=evaluated permission=bash pattern="python3 -c '\n# Training done m16 = 34.13 / 320. Remaining in m17..23 (7 months) = 285.87.\n# Current capacity in m17..23 (after m17 reserves 1/1/1 for m18..23):\n# us:\n#   m17..19: 7.14 owned + 1 (m16..21) + 1 (m17..22) + 4 opt (m17..22) = 13.14 (m17), 14.14 (m18..19)\n#   m20..21: 1 + 1 + 4 + 1 = 7\n#   m22:     1 + 4 + 1 = 6\n#   m23:     1\nus_cap = [13.14, 14.14, 14.14, 7.0, 7.0, 6.0, 1.0] # m17..23\n# eu:\n#   m17..19: 4.00 owned + 1 (m16..21) + 1 (m17..22) + 2 opt (m17..22) = 8.00 (m17), 9.00 (m18..19)\n#   m20..21: 1 + 1 + 2 + 1 = 5\n#   m22:     1 + 2 + 1 = 4\n#   m23:     1\neu_cap = [8.00, 9.00, 9.00, 5.0, 5.0, 4.0, 1.0] # m17..23\n# ap:\n#   m17..21: 29.86 owned + 3 (m10..21) + 1 (m16..21) + 1 (m17..22) + 1 (m18..23 at m18+) = 34.86 (m17), 35.86 (m18..21)\n#   m22:     29.86 + 1 (m17..22) + 1 (m18..23) = 31.86\n#   m23:     29.86 + 1 (m18..23) = 30.86\nap_cap = [34.86, 35.86, 35.86, 35.86, 35.86, 31.86, 30.86] # m17..23\ntot_cap = [us_cap[i]+eu_cap[i]+ap_cap[i] for i in range(7)]\nprint(\"m17..23 tot_cap:\", tot_cap, \"sum=\", sum(tot_cap))\nprint(\"m17..23 us_cap:\", us_cap)\nprint(\"m17..23 eu_cap:\", eu_cap)\n\n# Demand m17..23 at 8%/mo from m16=12.87:\ninf8 = [12.87 * (1.08**(t-16)) for t in range(17, 24)]\nprint(\"inf8 m17..23:\", [round(x,2) for x in inf8], \"sum=\", round(sum(inf8),1))\nprint(\"inf8 us m17..23:\", [round(0.5*x,2) for x in inf8])\nprint(\"inf8 eu m17..23:\", [round(0.3*x,2) for x in inf8])\nprint(\"inf8 ap m17..23:\", [round(0.2*x,2) for x in inf8])\n\n# Training gap in m17..23:\nneed = 285.87 + sum(inf8)\nshortfall = need - sum(tot_cap)\nprint(\"need total cap m17..23:\", round(need,1), \"shortfall:\", round(shortfall,1), \"in 6m units:\", round(shortfall/6, 2))\n# With +10% inference noise buffer (say +12 kH-months buffer on top):\nprint(\"With +12 buffer, 6m units needed:\", round((shortfall+12)/6, 2))\n'" action.permission=* action.action=allow action.pattern=*
