timestamp=2026-11-14T20:59:03.051Z level=INFO run=0d3e2444 message=evaluated permission=bash pattern="python3 -c '\n# Gen N: $40M per 1k = $20M per kH. Power = 0.8 MW per kH.\n# Salvage at m24 = 0.75 * 20 * 0.96^(24 - launch) where launch=9 -> 0.96^15 = 0.54209 -> $8.131M per kH!\nfor arrival in [12, 13, 14, 15, 16]:\n    months_used = 24 - arrival\n    net_capex = 20.0 - 0.75 * 20.0 * (0.96**(24-9))\n    power_ap = 0.8 * 0.12 * 24 # $2.304M\n    # interest approx: 0.75%/mo on $20M for (arrival-9)? No, paid at order! Suppose ordered at arrival-3\n    order_m = arrival - 3\n    # rough opportunity cost of cash at 0.75%/mo minus salvage discounting\n    opp = 20.0 * (1.0075**(24-order_m) - 1) - 8.131 * (1.0075**0 - 1) # wait: salvage paid at m24, so full $20M ties up cash from order_m to 24!\n    # Actually at m24 you get salvage, so tied up cash = $20M for (24 - order_m) months -> 20*(1.0075^(24-order_m)-1)\n    # Wait: cloud is paid monthly, so ~half the duration! Compare on NPV/m24-dollar basis:\n    total_m24_cost = net_capex + power_ap + 20.0 * (1.0075**(24-order_m) - 1)\n    print(f\"arrival m{arrival} (ordered m{order_m}, used {months_used}m): net_capex={net_capex:.2f}, power={power_ap:.2f}, opp_cost={20.0*(1.0075**(24-order_m)-1):.2f}, total/mo={total_m24_cost/months_used:.3f}\")\n'" action.permission=* action.action=allow action.pattern=*
