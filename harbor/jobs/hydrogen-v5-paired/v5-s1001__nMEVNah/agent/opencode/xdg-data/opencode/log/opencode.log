timestamp=2026-11-14T21:01:40.242Z level=INFO run=0d3e2444 message=evaluated permission=bash pattern="python3 -c '\n# Current capacities in m16..23:\n# Owned powered:\n#   us: 7.14 (m16..19), 0 (m20..23)\n#   eu: 4.00 (m16..19), 0 (m20..23)\n#   ap: 6.86 + 23.00 = 29.86 (m16..23)\n# Reserved so far:\n#   ap: 3 (m10..21), 1 (m16..21), 1 (m17..22)\n#   us: 1 (m16..21), 1 (m17..22)\n#   eu: 1 (m16..21), 1 (m17..22)\nus_cap = [7.14+1, 7.14+2, 7.14+2, 7.14+2, 2, 2, 1, 0] # m16..23\neu_cap = [4.00+1, 4.00+2, 4.00+2, 4.00+2, 2, 2, 1, 0]\nap_cap = [29.86+4, 29.86+5, 29.86+5, 29.86+5, 29.86+5, 29.86+5, 29.86+1, 29.86]\ntot_cap = [us_cap[i]+eu_cap[i]+ap_cap[i] for i in range(8)]\nprint(\"Current total cap m16..23:\", tot_cap, \"sum=\", sum(tot_cap))\nprint(\"Current us cap m16..23:\", us_cap)\nprint(\"Current eu cap m16..23:\", eu_cap)\n\n# Demand projections from m15=11.87:\n# Worst case (8%/mo from m15=11.87):\ninf8 = [11.87 * (1.08**(t-15)) for t in range(16, 24)]\n# 4%/mo from m15=11.87:\ninf4 = [11.87 * (1.04**(t-15)) for t in range(16, 24)]\nprint(\"inf8 m16..23:\", [round(x,2) for x in inf8], \"sum=\", round(sum(inf8),1))\nprint(\"inf8 us m16..23:\", [round(0.5*x,2) for x in inf8])\nprint(\"inf8 eu m16..23:\", [round(0.3*x,2) for x in inf8])\nprint(\"inf8 ap m16..23:\", [round(0.2*x,2) for x in inf8])\nprint(\"inf4 sum=\", round(sum(inf4),1))\nprint(\"Need total cap (inf8 + 320):\", round(sum(inf8)+320, 1), \"shortfall vs current:\", round(sum(inf8)+320 - sum(tot_cap), 1))\nprint(\"Need total cap (inf4 + 320):\", round(sum(inf4)+320, 1), \"shortfall vs current:\", round(sum(inf4)+320 - sum(tot_cap), 1))\n'" action.permission=* action.action=allow action.pattern=*
